---
// src/components/Header.astro
import LogoBee from './LogoBee.jsx';
import ButtonBookNow from './ButtonBookNow.astro';
import HeaderIsland from './HeaderIsland.jsx';
---

<HeaderIsland client:load>
  <a href="#home" class="scroll-to-top flex items-center cursor-none" slot="logo">
    <span class="ml-2 text-2xl md:text-3xl font-bold text-neutral-200 hover:text-white" data-bright>LingoHive</span>
    <LogoBee
      className="w-[40px] h-[40px] md:w-[45px] md:h-[45px]"
    />
  </a>

  <div slot="buttonBookNowDesktop">
    <ButtonBookNow text="SOBRE ESTA DEMO" variant="header" />
  </div>

  <div slot="buttonBookNowMobile">
    <ButtonBookNow text="SOBRE ESTA DEMO" variant="mobile" />
  </div>
</HeaderIsland>

<noscript>
  <style is:global>#header button[aria-controls="mobile-list"] { display: none; }</style>
  <nav aria-label="Navegación sin JavaScript" class="fixed inset-x-4 top-20 z-50 rounded-2xl bg-neutral-900 px-4 py-2 text-sm text-white flex flex-wrap justify-center gap-x-4 gap-y-2 lg:hidden">
    <a href="#home">Home</a><a href="#whyus">Nosotros</a><a href="#pricing">Precios</a><a href="#testimonials">Testimonios</a><a href="#sobre-la-demo">Sobre esta demo</a>
  </nav>
</noscript>
